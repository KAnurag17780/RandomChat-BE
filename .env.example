# ============================================================
# Random Chat Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=randomchat
POSTGRES_USER=randomchat
POSTGRES_PASSWORD=change_me_in_production

# --- Application ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database connection (used by Spring Boot)
DB_HOST=localhost
DB_PORT=5432

# CORS - comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174

# WebSocket
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174
WS_MAX_MESSAGE_SIZE=8192
WS_SEND_BUFFER_SIZE=524288
WS_SEND_TIME_LIMIT=10000

# Heartbeat
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=90
